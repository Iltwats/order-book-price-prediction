# Keep datasets, environments, git history, and untracked caches outside Docker build contexts.
**
!.dockerignore
!requirements.txt
!requirements-train.txt
!utils.py
!solution.py
!submission_config.json
!connectome/
!connectome/*.py
!experiments/
!experiments/*.py
!native/
!native/*.cpp
!native/*.h
!native/*.py
!scripts/
!scripts/*
!cloud/
!cloud/*
!models/
!models/**
!baseline/
!baseline/baseline.onnx
!baseline/solution.py
!artifacts/
!artifacts/manifest.json
!artifacts/experiments/
!artifacts/experiments/data_semantics/
!artifacts/experiments/data_semantics/class_labels.npz
!artifacts/experiments/mask_propensity/
!artifacts/experiments/mask_propensity/model.npz

